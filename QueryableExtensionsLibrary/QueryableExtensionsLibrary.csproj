<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <PackageId>TL.QueryableExtensionsLibrary</PackageId>
    <Title>QueryableExtensionsLibrary</Title>
    <Description>Dynamic IQueryable extensions for EF Core: keyset pagination, string-based filtering, safe sorting, and conditional queries for clean APIs.</Description>
    <PackageTags>$(PackageTags);queryable;linq;dynamic-filter;keyset-pagination;sql;entity-framework;expression-trees</PackageTags>
  </PropertyGroup>
</Project>
